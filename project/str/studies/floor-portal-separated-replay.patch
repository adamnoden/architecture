diff --git a/project/str/studies/floor_portal_rewind_contact.py b/project/str/studies/floor_portal_rewind_contact.py
new file mode 100644
index 0000000000000000000000000000000000000000..e833799c77558e3ab6f2e7460cf8cf973fab5a0d
--- /dev/null
+++ b/project/str/studies/floor_portal_rewind_contact.py
@@ -0,0 +1,91 @@
+"""Scratch gauge-invariant contact comparison of the separated roof supports."""
+import numpy as np
+from scipy.linalg import solve as dense_solve
+from floor_portal_frame import Solve
+
+
+class RewindContactSolve:
+    def __init__(self, house):
+        self.k = house.k
+        self.fixed = np.array(house.fixed)
+        self.contacts = house.contacts
+        self.rigid = np.zeros((house.k.shape[0], 3))
+        roof_fields = house.roof.rigid
+        self.rigid[house.roof.mounted] = np.c_[
+            roof_fields[:, 2],
+            (roof_fields[:, 3] + 6475 * roof_fields[:, 1]) / 6000,
+            (roof_fields[:, 4] - 6475 * roof_fields[:, 0]) / 6000,
+        ]
+        residual = np.max(abs(self.k @ self.rigid))
+        assert residual < .02, residual
+        self.gauge = []
+        for point in [(332.5, 332.5), (11667.5, 332.5), (332.5, 11667.5)]:
+            self.gauge.append(house.roof.mounted[house.roof.keys['ringVertical', point, 0]])
+        assert abs(np.linalg.det(self.rigid[self.gauge])) > 3.
+        self.base = Solve(self.k, [*house.fixed, *self.gauge])
+        self.physical_index = np.searchsorted(self.base.fixed, house.fixed)
+        self.U = np.zeros((house.k.shape[0], len(self.contacts)))
+        self.stiffness = np.array([r['stiffness'] for r in self.contacts])
+        self.initial_gap = np.array([r['initial_gap'] for r in self.contacts])
+        for col, contact in enumerate(self.contacts):
+            np.add.at(self.U[:, col], contact['ids'], contact['row'])
+        self.X = self.base(self.U)
+        self.C = self.U.T @ self.X
+        assert np.max(abs(self.C - self.C.T)) < 1e-8
+        self.B = self.U.T @ self.rigid
+
+    def __call__(self, f, prescribed=None):
+        if prescribed is not None:
+            physical = prescribed
+            prescribed = np.zeros(len(self.base.fixed))
+            prescribed[self.physical_index] = physical
+        u0 = self.base(f, prescribed)
+        g0 = self.U.T @ u0 + self.initial_gap
+        resultant = self.rigid.T @ f
+        active = np.ones(len(g0), dtype=bool)
+        q = np.zeros(len(active))
+        for iteration in range(60):
+            q[:] = 0.
+            i = np.flatnonzero(active)
+            compliance = self.C[np.ix_(i, i)] + np.diag(1 / self.stiffness[i])
+            b = self.B[i]
+            assert np.linalg.matrix_rank(b) == 3, (resultant, len(i), iteration)
+            scale = 1e-4
+            values = dense_solve(np.block([[compliance, scale * b], [scale * b.T, np.zeros((3, 3))]]),
+                                 -np.r_[g0[i], scale * resultant], assume_a='gen')
+            q[i] = values[:-3]
+            shift = scale * values[-3:]
+            gap = g0 + self.C @ q + self.B @ shift
+            new = np.where(active, q > 1e-7, gap < -1e-9)
+            if np.array_equal(new, active):
+                break
+            active = new
+        else:
+            raise AssertionError('Gauge contact active set did not settle')
+        u = u0 + self.X @ q + self.rigid @ shift
+        for step in range(3):
+            residual = self.k @ u - f - self.U @ q
+            actual = self.U.T @ u + self.initial_gap
+            du = self.base(-residual)
+            active_gap_error = actual[i] + q[i] / self.stiffness[i]
+            correction = dense_solve(np.block([[compliance, scale * b], [scale * b.T, np.zeros((3, 3))]]),
+                np.r_[-active_gap_error - self.U[:, i].T @ du, scale * (self.rigid.T @ residual)], assume_a='gen')
+            q[i] += correction[:-3]
+            u += du + self.X[:, i] @ correction[:-3] + self.rigid @ (scale * correction[-3:])
+        actual = self.U.T @ u + self.initial_gap
+        error = float(np.max(abs(q - self.stiffness * np.maximum(-actual, 0))))
+        if error >= .03:
+            limits = abs(q - self.stiffness * np.maximum(-actual, 0))
+            idx = int(np.argmax(limits))
+            raise AssertionError(dict(error=error, iteration=iteration, contact=self.contacts[idx]['name'],
+                stiffness=self.stiffness[idx], q=q[idx], actual=actual[idx], calculated=gap[idx],
+                u0=float(max(abs(u0))), c_sym=float(np.max(abs(self.C - self.C.T))),
+                name=self.contacts[idx]['name'], globalShift=shift.tolist()))
+        reaction = self.k @ u - f - self.U @ q
+        assert max(abs(reaction[self.gauge])) < .01
+        physical = np.zeros_like(reaction)
+        physical[self.fixed] = reaction[self.fixed]
+        maximum_free = float(max(abs(reaction - physical)))
+        assert maximum_free < .05, maximum_free
+        return u, physical, dict(force=q, gap=actual, active=active, iterations=iteration + 1,
+            errorN=error, maximumFreeRowResidual=maximum_free, gaugeResidual=reaction[self.gauge].tolist())
