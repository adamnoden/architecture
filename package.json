{
  "name": "house-kernel-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev .",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "publication:validate": "tsx publication/scripts/validate.ts && tsx publication/scripts/validate-figures.ts",
    "publication:integrity": "tsx publication/scripts/integrity.ts",
    "publication:scope:update": "tsx publication/scripts/update-scope-report.ts",
    "publication:prepare:smoke": "tsx publication/scripts/prepare.ts --smoke",
    "publication:build:smoke": "npm run publication:prepare:smoke && vivliostyle build -c publication/vivliostyle.config.js",
    "publication:prepare:primer": "tsx publication/scripts/prepare.ts --primer",
    "publication:build:primer": "npm run publication:prepare:primer && vivliostyle build -c publication/vivliostyle.config.js",
    "publication:prepare": "tsx publication/scripts/prepare.ts --full",
    "publication:build": "npm run publication:prepare && vivliostyle build -c publication/vivliostyle.config.js",
    "status:update": "tsx scripts/update-status.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run docs:build",
    "artifacts:check": "npm run test:ch00 && npm run test:ch05",
    "artifacts:generate": "npm run rh-c1:generate && npm run rh-c2:generate && npm run rh-c3:generate && npm run rh-c4:generate",
    "outputs:reports:generate": "tsx compiler/reference-house/output/generate-reports.ts",
    "outputs:spatial:generate": "tsx compiler/reference-house/output/generate-spatial.ts",
    "outputs:generate": "tsx compiler/reference-house/output/generate.ts",
    "outputs:check": "tsx compiler/reference-house/output/verify.ts",
    "test:repo": "tsx scripts/validate-repository.ts",
    "test:brand": "tsx scripts/validate-project-brand.ts",
    "test:routes": "tsx scripts/validate-public-routes.ts",
    "test:p0": "node --import tsx --test compiler/p0/*.test.ts",
    "test:crosswalk": "node --import tsx --test compiler/crosswalk/*.test.ts",
    "rh-c1:generate": "tsx compiler/reference-house/generate.ts",
    "test:rh-c1": "node --import tsx --test compiler/reference-house/*.test.ts",
    "test:cf01": "node --import tsx --test compiler/cf01/*.test.ts",
    "rh-c2:generate": "tsx compiler/rhc2/generate.ts",
    "test:rh-c2": "node --import tsx --test compiler/rhc2/*.test.ts",
    "rh-c3:generate": "tsx compiler/rhc3/generate.ts",
    "test:rh-c3": "node --import tsx --test compiler/rhc3/*.test.ts",
    "rh-c4:generate": "tsx compiler/rhc4/generate.ts",
    "test:rh-c4": "node --import tsx --test compiler/rhc4/*.test.ts",
    "test:rh-c5": "node --import tsx --test compiler/rhc5/*.test.ts",
    "test:ch00": "node --import tsx --test compiler/ch00/*.test.ts",
    "test:ch01": "node --import tsx --test compiler/ch01/*.test.ts",
    "test:ch02": "node --import tsx --test compiler/ch02/*.test.ts",
    "test:ch03": "node --import tsx --test compiler/ch03/*.test.ts",
    "test:ch04": "node --import tsx --test compiler/ch04/*.test.ts",
    "test:ch05": "node --import tsx --test compiler/ch05/*.test.ts",
    "test:ch06": "node --import tsx --test compiler/ch06/*.test.ts",
    "test:ch07": "node --import tsx --test compiler/ch07/*.test.ts",
    "test:ch08": "node --import tsx --test compiler/ch08/*.test.ts",
    "test:coa00": "node --import tsx --test compiler/coa00/*.test.ts",
    "test:coa01": "node --import tsx --test compiler/coa01/*.test.ts",
    "test:coa02": "node --import tsx --test compiler/coa02/*.test.ts",
    "test:coa03": "node --import tsx --test compiler/coa03/*.test.ts",
    "test:coa04": "node --import tsx --test compiler/coa04/*.test.ts",
    "test:coa05": "node --import tsx --test compiler/coa05/*.test.ts",
    "test:coa06": "node --import tsx --test compiler/coa06/*.test.ts",
    "test": "npm run typecheck && npm run test:repo && npm run test:brand && npm run test:routes && npm run test:p0 && npm run test:crosswalk && npm run test:rh-c1 && npm run test:cf01 && npm run test:rh-c2 && npm run test:rh-c3 && npm run test:rh-c4 && npm run test:rh-c5 && npm run test:ch00 && npm run test:ch01 && npm run test:ch02 && npm run test:ch03 && npm run test:ch04 && npm run test:ch05 && npm run test:ch06 && npm run test:ch07 && npm run test:ch08 && npm run test:coa00 && npm run test:coa01 && npm run test:coa02 && npm run test:coa03 && npm run test:coa04 && npm run test:coa05 && npm run test:coa06 && npm run outputs:check && npm run publication:validate && npm run publication:integrity"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@types/node": "^24.7.0",
    "@vivliostyle/cli": "11.3.3",
    "mermaid": "^11.17.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  },
  "engines": {
    "node": ">=22.12"
  }
}
