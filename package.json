{
  "name": "house-systems-architecture-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev .",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "typecheck": "tsc --noEmit",
    "test:p0": "node --import tsx --test compiler/p0/*.test.ts",
    "test:crosswalk": "node --import tsx --test compiler/crosswalk/*.test.ts",
    "test": "npm run typecheck && npm run test:p0 && npm run test:crosswalk"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=20"
  }
}
